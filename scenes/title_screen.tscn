[sub_resource type="GDScript" id="GDScript_yh20n"]
script/source = "extends Node2D

const FIRST_LEVEL = preload(\"res://scenes/forest.tscn\")

func _ready() -> void:
	$Buttons/PlayButton.grab_focus()

func _on_play_button_button_down() -> void:
	$Buttons/PlayButton/Text.position.y += 30
	$Buttons/PlayButton.icon.region = Rect2(64, 0, 64, 20)
	

func _on_play_button_button_up() -> void:
	get_tree().change_scene_to_packed(FIRST_LEVEL)

func _on_quit_button_button_down() -> void:
	$Buttons/QuitButton/Text.position.y += 30
	$Buttons/QuitButton.icon.region = Rect2(64, 0, 64, 20)

func _on_quit_button_button_up() -> void: get_tree().quit()
"

